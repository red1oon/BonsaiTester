#!/usr/bin/env python3
"""
BonsaiTester - Main CLI Entry Point
====================================

Fast, headless testing for Bonsai BIM databases.

Usage:
    bonsai-test --fast database.db           # Tier 1 only (schema)
    bonsai-test --geometry database.db       # Tier 1 + 2 (schema + geometry)
    bonsai-test --full database.db           # All tiers (includes Blender)

    bonsai-test --sample 100 database.db     # Test random 100 elements
    bonsai-test --verbose database.db        # Detailed output
    bonsai-test --json database.db           # JSON output (for GUI/scripting)

Author: Redhuan D. Oon <red1org@gmail.com>
License: LGPL-3.0
"""

import sys
import time
import json
import argparse
from pathlib import Path

# Add bonsai_tester to path
sys.path.insert(0, str(Path(__file__).parent))

from bonsai_tester.validators.geometry_validator import validate_database_geometries
from bonsai_tester.validators.schema_validator import validate_database_schema
from bonsai_tester.logger import BonsaiLogger, HTMLReportGenerator
from bonsai_tester.repair import repair_database


def main():
    parser = argparse.ArgumentParser(
        description='BonsaiTester - Headless validation for Bonsai BIM databases',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s database.db                    # Quick geometry validation
  %(prog)s --fast database.db             # Schema only (fastest)
  %(prog)s --sample 50 database.db        # Test 50 random elements
  %(prog)s --verbose database.db          # Detailed output

Tiers:
  Tier 1 (--fast):     Database schema validation (< 5s)
  Tier 2 (default):    Geometry validation (10-20s)
  Tier 3 (--full):     Visual validation with Blender (30-60s)
        """
    )

    parser.add_argument('database', type=Path, help='Path to Bonsai database (.db file)')

    # Test modes
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument('--fast', action='store_true',
                           help='Tier 1 only: Schema validation (fastest)')
    mode_group.add_argument('--geometry', action='store_true',
                           help='Tier 1 + 2: Schema + geometry validation (default)')
    mode_group.add_argument('--full', action='store_true',
                           help='All tiers: Schema + geometry + visual (requires Blender)')

    # Options
    parser.add_argument('--sample', type=int, metavar='N',
                       help='Validate random sample of N elements (default: all)')
    parser.add_argument('--verbose', '-v', action='store_true',
                       help='Print detailed validation results')
    parser.add_argument('--json', action='store_true',
                       help='Output results in JSON format (for GUI/scripting)')
    parser.add_argument('--repair', action='store_true',
                       help='Auto-repair degenerate faces (creates <db>_repaired.db)')
    parser.add_argument('--version', action='version', version='BonsaiTester 0.1.0')

    args = parser.parse_args()

    # Check database exists
    if not args.database.exists():
        if args.json:
            error_output = {
                'error': 'Database not found',
                'database': str(args.database),
                'success': False
            }
            print(json.dumps(error_output, indent=2))
        else:
            print(f"❌ Database not found: {args.database}")
        return 1

    # Determine mode (default: geometry)
    if args.fast:
        mode = 'fast'
    elif args.full:
        mode = 'full'
    else:
        mode = 'geometry'  # Default

    # Print header (skip if JSON mode)
    if not args.json:
        print("=" * 70)
        print("BONSAI TESTER v0.1.0")
        print("=" * 70)
        print(f"Database: {args.database}")
        print(f"Size: {args.database.stat().st_size / (1024**2):.1f} MB")
        print(f"Mode: {mode.upper()}")
        if args.sample:
            print(f"Sample: {args.sample} elements")
        print("=" * 70)

    start_time = time.time()

    # Run tests based on mode
    if mode == 'fast':
        # Initialize logger
        logger = None
        if not args.json:
            logger = BonsaiLogger(args.database, mode='fast')
            logger.log_section("[Tier 1: Schema Validation]")

        # Run schema validation
        results = validate_database_schema(args.database, verbose=args.verbose)
        elapsed = time.time() - start_time

        # JSON output mode
        if args.json:
            output = {
                'mode': 'fast',
                'database': str(args.database),
                'schema_type': results['schema_type'],
                'results': results,
                'success': results['failed'] == 0
            }
            print(json.dumps(output, indent=2))
            return 0 if results['failed'] == 0 else 1

        # Normal text output
        print(f"\n{'=' * 70}")
        print("SCHEMA VALIDATION SUMMARY")
        print(f"{'=' * 70}")
        print(f"Schema Type: {results['schema_type']}")
        print(f"✓ Passed: {results['passed']}")
        print(f"✗ Failed: {results['failed']}")
        print(f"Time: {elapsed:.1f} seconds")
        print(f"{'=' * 70}")

        # Log results
        if logger:
            logger.log_section("SCHEMA VALIDATION SUMMARY", to_console=False)
            logger.log(f"Schema Type: {results['schema_type']}", to_console=False)
            logger.log(f"✓ Passed: {results['passed']}", to_console=False)
            logger.log(f"✗ Failed: {results['failed']}", to_console=False)

            for check in results['checks']:
                status = "✓" if check['passed'] else "✗"
                logger.log(f"  {status} {check['name']}: {check['message']}", to_console=False)

        if results['failed'] > 0:
            print(f"\n❌ SCHEMA VALIDATION FAILED")
            print("\nFailed checks:")
            for check in results['checks']:
                if not check['passed']:
                    print(f"  ✗ {check['name']}: {check['message']}")

            if logger:
                logger.log_section("TEST RESULT: FAILED", to_console=False)
                logger.close()
                print(f"📝 Full log saved to: logs/{logger.get_log_path().name}")

            return 1
        else:
            print("\n✅ ALL SCHEMA CHECKS PASSED")

            if logger:
                logger.log_section("TEST RESULT: PASSED", to_console=False)
                logger.close()
                print(f"📝 Full log saved to: logs/{logger.get_log_path().name}")

            return 0

    elif mode == 'geometry':
        # Initialize logger (logs saved to DB directory)
        logger = None
        if not args.json:
            logger = BonsaiLogger(args.database, mode='geometry')
            logger.log_section("[Tier 2: Geometry Validation]")

        # Run validation
        results = validate_database_geometries(
            args.database,
            sample_size=args.sample,
            verbose=args.verbose
        )

        elapsed = time.time() - start_time
        results['elapsed_time'] = elapsed

        # JSON output mode (for GUI/scripting)
        if args.json:
            output = {
                'mode': 'geometry',
                'database': str(args.database),
                'database_size_mb': args.database.stat().st_size / (1024**2),
                'sample_size': args.sample,
                'results': results,
                'success': results['failed'] == 0
            }
            print(json.dumps(output, indent=2))
            return 0 if results['failed'] == 0 else 1

        # Normal text output with logging
        print(f"\n{'=' * 70}")
        print("VALIDATION SUMMARY")
        print(f"{'=' * 70}")
        print(f"Total geometries: {results['total']:,}")
        print(f"Validated: {results['validated']:,}")
        print(f"✓ Passed: {results['passed']:,}")
        print(f"✗ Failed: {results['failed']:,}")
        print(f"Time: {elapsed:.1f} seconds")
        print(f"{'=' * 70}")

        # Log results
        if logger:
            logger.log_section("VALIDATION SUMMARY", to_console=False)
            logger.log_results(results, to_console=False)

        # Generate HTML report
        if logger:
            html_gen = HTMLReportGenerator(args.database, results, elapsed, mode='geometry')
            html_path = html_gen.generate()
            logger.log(f"\n📊 HTML report generated: logs/{html_path.name}", to_console=True)

        if results['failed'] > 0:
            print(f"\n❌ VALIDATION FAILED - {results['failed']} geometry errors")
            print("\nFirst 10 failures:")
            for failure in results['failures'][:10]:
                print(f"  • {failure['guid']}:")
                for msg in failure['failures']:
                    print(f"    └─ {msg}")

            # Auto-repair if requested
            if args.repair:
                print(f"\n{'=' * 70}")
                print("AUTO-REPAIR MODE")
                print(f"{'=' * 70}")

                repair_results = repair_database(args.database, verbose=args.verbose)

                print(f"\nRepair complete:")
                print(f"  Elements repaired: {repair_results['repaired_elements']:,}")
                print(f"  Faces removed: {repair_results['total_faces_removed']:,}")
                print(f"  Output: {Path(repair_results['output_path']).name}")

                if logger:
                    logger.log_section("AUTO-REPAIR APPLIED", to_console=False)
                    logger.log(f"Elements repaired: {repair_results['repaired_elements']:,}", to_console=False)
                    logger.log(f"Faces removed: {repair_results['total_faces_removed']:,}", to_console=False)
                    logger.log(f"Output: {repair_results['output_path']}", to_console=False)

                print(f"\n💡 Re-run validation on repaired database:")
                print(f"   ./bonsai-test {Path(repair_results['output_path']).name}")

            if logger:
                logger.log_section("TEST RESULT: FAILED", to_console=False)
                logger.close()
                print(f"📝 Full log saved to: logs/{logger.get_log_path().name}")

            return 1
        else:
            print("\n✅ ALL GEOMETRIES VALID")

            if logger:
                logger.log_section("TEST RESULT: PASSED", to_console=False)
                logger.close()
                print(f"📝 Full log saved to: logs/{logger.get_log_path().name}")

            return 0

    elif mode == 'full':
        print("\n[Tier 1: Schema Validation] - NOT YET IMPLEMENTED")
        print("[Tier 2: Geometry Validation] - Running...")

        results = validate_database_geometries(
            args.database,
            sample_size=args.sample,
            verbose=args.verbose
        )

        print(f"  ✓ Passed: {results['passed']:,}")
        print(f"  ✗ Failed: {results['failed']:,}")

        print("\n[Tier 3: Visual Validation] - NOT YET IMPLEMENTED")
        print("Coming soon: Blender background mode snapshot testing")

        elapsed = time.time() - start_time
        print(f"\nTotal time: {elapsed:.1f} seconds")

        return 0 if results['failed'] == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
