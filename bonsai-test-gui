#!/usr/bin/env python3
"""
BonsaiTester GUI - Graphical Interface
=======================================

User-friendly GUI wrapper for BonsaiTester validation tools.

Features:
- Browse and select database files
- Choose validation tests (checkboxes)
- Run tests with visual progress
- Display color-coded results
- Export reports

Author: Redhuan D. Oon <red1org@gmail.com>
License: LGPL-3.0
"""

import tkinter as tk
from tkinter import ttk, filedialog, scrolledtext, messagebox
import subprocess
import json
import threading
from pathlib import Path
import sys


class BonsaiTesterGUI:
    """Main GUI application for BonsaiTester"""

    def __init__(self, root):
        self.root = root
        self.root.title("BonsaiTester v0.1.0 - Validation Tool")
        self.root.geometry("800x700")
        self.root.resizable(True, True)

        # Get CLI path (same directory as this script)
        self.cli_path = Path(__file__).parent / "bonsai-test"

        # Variables
        self.database_path = tk.StringVar()
        self.tier1_enabled = tk.BooleanVar(value=False)  # Not implemented yet
        self.tier2_enabled = tk.BooleanVar(value=True)   # Default enabled
        self.tier3_enabled = tk.BooleanVar(value=False)  # Not implemented yet
        self.sample_enabled = tk.BooleanVar(value=False)
        self.sample_size = tk.StringVar(value="100")
        self.verbose_enabled = tk.BooleanVar(value=False)

        # Running state
        self.is_running = False

        self.create_widgets()

    def create_widgets(self):
        """Create all GUI widgets"""

        # Header
        header_frame = tk.Frame(self.root, bg="#2c3e50", height=60)
        header_frame.pack(fill=tk.X)
        header_frame.pack_propagate(False)

        title_label = tk.Label(
            header_frame,
            text="BonsaiTester 🧪",
            font=("Arial", 20, "bold"),
            fg="white",
            bg="#2c3e50"
        )
        title_label.pack(pady=15)

        # Main content area with padding
        main_frame = tk.Frame(self.root, padx=20, pady=20)
        main_frame.pack(fill=tk.BOTH, expand=True)

        # Database selection
        db_frame = tk.LabelFrame(main_frame, text="Database", font=("Arial", 10, "bold"), padx=10, pady=10)
        db_frame.pack(fill=tk.X, pady=(0, 15))

        db_entry_frame = tk.Frame(db_frame)
        db_entry_frame.pack(fill=tk.X)

        self.db_entry = tk.Entry(db_entry_frame, textvariable=self.database_path, font=("Arial", 10))
        self.db_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10))

        browse_btn = tk.Button(
            db_entry_frame,
            text="Browse...",
            command=self.browse_database,
            bg="#3498db",
            fg="white",
            font=("Arial", 10),
            padx=20,
            cursor="hand2"
        )
        browse_btn.pack(side=tk.RIGHT)

        # Database info label
        self.db_info_label = tk.Label(db_frame, text="", font=("Arial", 9), fg="#7f8c8d")
        self.db_info_label.pack(anchor=tk.W, pady=(5, 0))

        # Tests selection
        tests_frame = tk.LabelFrame(main_frame, text="Validation Tests", font=("Arial", 10, "bold"), padx=10, pady=10)
        tests_frame.pack(fill=tk.X, pady=(0, 15))

        tier1_check = tk.Checkbutton(
            tests_frame,
            text="Tier 1: Schema Validation (Coming Soon)",
            variable=self.tier1_enabled,
            font=("Arial", 10),
            state=tk.DISABLED
        )
        tier1_check.pack(anchor=tk.W, pady=2)

        tier2_check = tk.Checkbutton(
            tests_frame,
            text="Tier 2: Geometry Validation",
            variable=self.tier2_enabled,
            font=("Arial", 10, "bold")
        )
        tier2_check.pack(anchor=tk.W, pady=2)

        tier2_desc = tk.Label(
            tests_frame,
            text="    • Validates vertices, faces, normals, bounding boxes",
            font=("Arial", 9),
            fg="#7f8c8d"
        )
        tier2_desc.pack(anchor=tk.W)

        tier3_check = tk.Checkbutton(
            tests_frame,
            text="Tier 3: Visual Validation (Coming Soon)",
            variable=self.tier3_enabled,
            font=("Arial", 10),
            state=tk.DISABLED
        )
        tier3_check.pack(anchor=tk.W, pady=(10, 2))

        # Options
        options_frame = tk.LabelFrame(main_frame, text="Options", font=("Arial", 10, "bold"), padx=10, pady=10)
        options_frame.pack(fill=tk.X, pady=(0, 15))

        sample_frame = tk.Frame(options_frame)
        sample_frame.pack(anchor=tk.W, pady=2)

        sample_check = tk.Checkbutton(
            sample_frame,
            text="Sample validation (faster):",
            variable=self.sample_enabled,
            font=("Arial", 10)
        )
        sample_check.pack(side=tk.LEFT)

        sample_entry = tk.Entry(sample_frame, textvariable=self.sample_size, width=10, font=("Arial", 10))
        sample_entry.pack(side=tk.LEFT, padx=(10, 5))

        tk.Label(sample_frame, text="elements", font=("Arial", 10)).pack(side=tk.LEFT)

        verbose_check = tk.Checkbutton(
            options_frame,
            text="Verbose output (detailed results)",
            variable=self.verbose_enabled,
            font=("Arial", 10)
        )
        verbose_check.pack(anchor=tk.W, pady=2)

        # Action buttons
        button_frame = tk.Frame(main_frame)
        button_frame.pack(fill=tk.X, pady=(0, 15))

        self.run_btn = tk.Button(
            button_frame,
            text="▶ Run Tests",
            command=self.run_tests,
            bg="#27ae60",
            fg="white",
            font=("Arial", 12, "bold"),
            padx=30,
            pady=10,
            cursor="hand2"
        )
        self.run_btn.pack(side=tk.LEFT, padx=(0, 10))

        self.cancel_btn = tk.Button(
            button_frame,
            text="Cancel",
            command=self.cancel_tests,
            bg="#e74c3c",
            fg="white",
            font=("Arial", 12),
            padx=30,
            pady=10,
            cursor="hand2",
            state=tk.DISABLED
        )
        self.cancel_btn.pack(side=tk.LEFT)

        # Progress indicator
        self.progress_label = tk.Label(
            button_frame,
            text="",
            font=("Arial", 10),
            fg="#3498db"
        )
        self.progress_label.pack(side=tk.LEFT, padx=(20, 0))

        # Results area
        results_frame = tk.LabelFrame(main_frame, text="Results", font=("Arial", 10, "bold"), padx=10, pady=10)
        results_frame.pack(fill=tk.BOTH, expand=True)

        # Scrolled text for results
        self.results_text = scrolledtext.ScrolledText(
            results_frame,
            font=("Consolas", 10),
            wrap=tk.WORD,
            height=15
        )
        self.results_text.pack(fill=tk.BOTH, expand=True)

        # Configure text tags for color coding
        self.results_text.tag_config("success", foreground="#27ae60", font=("Consolas", 10, "bold"))
        self.results_text.tag_config("error", foreground="#e74c3c", font=("Consolas", 10, "bold"))
        self.results_text.tag_config("warning", foreground="#f39c12", font=("Consolas", 10, "bold"))
        self.results_text.tag_config("info", foreground="#3498db")
        self.results_text.tag_config("header", font=("Consolas", 11, "bold"))

        # Initial message
        self.show_welcome_message()

    def show_welcome_message(self):
        """Display welcome message in results area"""
        self.results_text.insert(tk.END, "Welcome to BonsaiTester! 🧪\n\n", "header")
        self.results_text.insert(tk.END, "Fast, headless validation for Bonsai BIM databases.\n\n")
        self.results_text.insert(tk.END, "Getting started:\n", "info")
        self.results_text.insert(tk.END, "1. Click 'Browse...' to select your database file (.db)\n")
        self.results_text.insert(tk.END, "2. Choose which tests to run (Tier 2 recommended)\n")
        self.results_text.insert(tk.END, "3. Click 'Run Tests' to start validation\n\n")
        self.results_text.insert(tk.END, "Tip: Use sample validation for quick checks on large databases.\n", "info")

    def browse_database(self):
        """Open file browser to select database"""
        filename = filedialog.askopenfilename(
            title="Select Bonsai Database",
            filetypes=[
                ("Database files", "*.db"),
                ("All files", "*.*")
            ],
            initialdir=str(Path.home() / "Documents" / "bonsai")
        )

        if filename:
            self.database_path.set(filename)
            # Show file info
            db_path = Path(filename)
            size_mb = db_path.stat().st_size / (1024**2)
            self.db_info_label.config(text=f"📁 {db_path.name} ({size_mb:.1f} MB)")

    def run_tests(self):
        """Run validation tests in background thread"""

        # Validation
        if not self.database_path.get():
            messagebox.showerror("Error", "Please select a database file first!")
            return

        db_path = Path(self.database_path.get())
        if not db_path.exists():
            messagebox.showerror("Error", f"Database file not found:\n{db_path}")
            return

        if not self.tier2_enabled.get():
            messagebox.showwarning("Warning", "No tests selected! Enable Tier 2 Geometry Validation.")
            return

        # Clear previous results
        self.results_text.delete(1.0, tk.END)

        # Update UI state
        self.is_running = True
        self.run_btn.config(state=tk.DISABLED)
        self.cancel_btn.config(state=tk.NORMAL)
        self.progress_label.config(text="⏳ Running validation...")

        # Run in background thread
        thread = threading.Thread(target=self.run_validation_thread, daemon=True)
        thread.start()

    def run_validation_thread(self):
        """Background thread to run CLI validation"""
        try:
            # Build CLI command
            cmd = [str(self.cli_path), str(self.database_path.get()), "--json"]

            if self.sample_enabled.get():
                try:
                    sample = int(self.sample_size.get())
                    cmd.extend(["--sample", str(sample)])
                except ValueError:
                    pass  # Ignore invalid sample size

            if self.verbose_enabled.get():
                cmd.append("--verbose")

            # Run CLI
            result = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=300  # 5 minute timeout
            )

            # Parse JSON output
            if result.returncode == 0 or result.stdout:
                try:
                    data = json.loads(result.stdout)
                    self.root.after(0, self.display_results, data)
                except json.JSONDecodeError:
                    self.root.after(0, self.display_error, "Failed to parse validation results")
            else:
                self.root.after(0, self.display_error, result.stderr)

        except subprocess.TimeoutExpired:
            self.root.after(0, self.display_error, "Validation timed out (>5 minutes)")
        except Exception as e:
            self.root.after(0, self.display_error, f"Unexpected error: {e}")
        finally:
            self.root.after(0, self.validation_complete)

    def display_results(self, data):
        """Display validation results in GUI"""
        results = data.get('results', {})

        # Header
        self.results_text.insert(tk.END, "="*70 + "\n", "header")
        self.results_text.insert(tk.END, "VALIDATION RESULTS\n", "header")
        self.results_text.insert(tk.END, "="*70 + "\n", "header")
        self.results_text.insert(tk.END, f"\nDatabase: {data.get('database')}\n")
        self.results_text.insert(tk.END, f"Size: {data.get('database_size_mb', 0):.1f} MB\n")
        self.results_text.insert(tk.END, f"Time: {results.get('elapsed_time', 0):.1f} seconds\n\n")

        # Summary
        total = results.get('total', 0)
        validated = results.get('validated', 0)
        passed = results.get('passed', 0)
        failed = results.get('failed', 0)

        self.results_text.insert(tk.END, "Summary:\n", "info")
        self.results_text.insert(tk.END, f"  Total geometries: {total:,}\n")
        self.results_text.insert(tk.END, f"  Validated: {validated:,}\n")
        self.results_text.insert(tk.END, f"  Passed: {passed:,}\n", "success")
        self.results_text.insert(tk.END, f"  Failed: {failed:,}\n", "error" if failed > 0 else "success")

        # Overall status
        if failed == 0:
            self.results_text.insert(tk.END, "\n✅ ALL GEOMETRIES VALID\n", "success")
        else:
            self.results_text.insert(tk.END, f"\n❌ VALIDATION FAILED - {failed} geometry errors\n", "error")

            # Show failures
            failures = results.get('failures', [])
            if failures:
                self.results_text.insert(tk.END, f"\nFirst {min(10, len(failures))} failures:\n\n", "warning")
                for failure in failures[:10]:
                    guid = failure.get('guid', 'Unknown')
                    self.results_text.insert(tk.END, f"  • {guid}:\n", "error")
                    for msg in failure.get('failures', []):
                        self.results_text.insert(tk.END, f"    └─ {msg}\n")

                if len(failures) > 10:
                    self.results_text.insert(tk.END, f"\n... and {len(failures) - 10} more errors\n", "warning")

        self.results_text.insert(tk.END, "\n" + "="*70 + "\n")

        # Show success message dialog if all passed
        if failed == 0:
            messagebox.showinfo(
                "Validation Complete",
                f"✅ All {passed:,} geometries are valid!\n\nTime: {results.get('elapsed_time', 0):.1f} seconds"
            )

    def display_error(self, error_msg):
        """Display error message"""
        self.results_text.insert(tk.END, "❌ ERROR\n", "error")
        self.results_text.insert(tk.END, f"\n{error_msg}\n")
        messagebox.showerror("Validation Error", error_msg)

    def validation_complete(self):
        """Reset UI state after validation"""
        self.is_running = False
        self.run_btn.config(state=tk.NORMAL)
        self.cancel_btn.config(state=tk.DISABLED)
        self.progress_label.config(text="")

    def cancel_tests(self):
        """Cancel running tests"""
        if self.is_running:
            # Note: subprocess termination is complex, for now just disable
            self.progress_label.config(text="⏸ Cancellation requested...")
            # In a production version, we'd need to track the subprocess and terminate it


def main():
    """Main entry point"""
    root = tk.Tk()
    app = BonsaiTesterGUI(root)

    # Center window on screen
    root.update_idletasks()
    width = root.winfo_width()
    height = root.winfo_height()
    x = (root.winfo_screenwidth() // 2) - (width // 2)
    y = (root.winfo_screenheight() // 2) - (height // 2)
    root.geometry(f'{width}x{height}+{x}+{y}')

    root.mainloop()


if __name__ == '__main__':
    main()
